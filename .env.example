# Copie ce fichier en .env. Les commentaires restent sur leur propre ligne (compatible systemd).
# Jeton d'accès : laissé vide, il est généré au premier lancement.
ACCESS_TOKEN=
# 127.0.0.1 derrière un reverse proxy (VPS), 0.0.0.0 sinon.
HOST=0.0.0.0
PORT=8080
# LLM compatible OpenAI
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
# Transcription vocale (optionnel)
STT_URL=
SCRIBE_DICTEE_TOKEN=
